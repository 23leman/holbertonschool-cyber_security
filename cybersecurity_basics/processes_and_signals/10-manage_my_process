#!/usr/bin/env bash
# Init script to start, stop and restart manage_my_process

PID_FILE="/var/run/my_process.pid"
# Əgər /var/run-a icazə yoxdursa, /tmp/my_process.pid istifadə edək
if [ ! -w /var/run ]; then
    PID_FILE="/tmp/my_process.pid"
fi

case "$1" in
    start)
        ./manage_my_process > /dev/null 2>&1 &
        echo $! > "$PID_FILE"
        echo "manage_my_process started"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")"
            rm "$PID_FILE"
        fi
        echo "manage_my_process stopped"
        ;;
    restart)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")"
            rm "$PID_FILE"
        fi
        ./manage_my_process > /dev/null 2>&1 &
        echo $! > "$PID_FILE"
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        ;;
esac
